DATABASE_URL="postgresql://whoami:changeme@localhost:5432/whoami?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical base URL for OAuth (HCA + Hackatime)
AUTH_URL="https://your-domain.com"
AUTH_HCA_CLIENT_ID=""
AUTH_HCA_CLIENT_SECRET=""

AUTH_HACKATIME_CLIENT_ID=""
AUTH_HACKATIME_CLIENT_SECRET=""

SUPERADMIN_EMAILS="admin@example.com,superadmin@example.com"
# Set to "true" to skip login entirely (dev/testing only — exposes all admin
# pages, the dashboard and server actions to everyone). NEVER enable in prod.
ADMIN_BYPASS="false"
AUTH_HACKATIME_CLIENT_ID=""
AUTH_HACKATIME_CLIENT_SECRET=""
ADMIN_BYPASS_HOURS=""
# Credits: 1 tracked hour = 10 credits (see CREDITS_PER_HOUR in lib/constants.ts).
# Prices are stored on each ShopItem row in the DB, not in env.
REDIS_URL="redis://127.0.0.1:6379"
# AES-GCM key (base64) for encrypting Hackatime tokens + recipient PII at rest.
# Decodes to 16, 24, or 32 bytes. Generate with:
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=""

EMAIL_PROVIDER="mailpit"          # mailpit | loops
MAILPIT_URL="http://127.0.0.1:8025"
EMAIL_FROM="noreply@your-domain.com"
LOOPS_API_KEY=""
LOOPS_TX_RECIPIENT_FORM_ID=""
SENTRY_DSN=""
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
FEATURE_EMAIL="false"
FEATURE_AIRTABLE="false"
FEATURE_RECIPIENT="true"
LOG_LEVEL="info"
