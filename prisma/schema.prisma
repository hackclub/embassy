generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
}

enum OrderTransition {
  AWAITING_RECIPIENT_DETAILS
  RECIPIENT_DETAILS_RECEIVED
  DRAFTING
  DRAFT_READY
  SENT_TO_HQ
  RECEIVED_FROM_HQ
  SHIPPING
  DELIVERED
  CANCELLED
  ERROR
}

enum EventType {
  ORDER_CREATED
  STATUS_CHANGED
  RECIPIENT_DETAILS_SUBMITTED
  RECIPIENT_DETAILS_UPDATED
  PASSPORT_VERSION_CREATED
  PASSPORT_VERSION_PROMOTED
  SHIPMENT_CREATED
  SHIPMENT_UPDATED
  EMAIL_SENT
  EMAIL_FAILED
  API_KEY_REGENERATED
  ROLE_CHANGED
  ORDER_CANCELLED
}

enum ActorType {
  ORGANIZER
  ADMIN
  SYSTEM
  RECIPIENT
  API
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REJECTED
  ACCEPTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  slackId       String?   @unique
  hcaId         String?   @unique
  role          Role      @default(PARTICIPANT)

  hackatimeUid            String?   @unique
  hackatimeLinkedAt       DateTime?
  hackatimeTokenEncrypted String?

  creditsBalance Int @default(0)

  accounts        Account[]
  sessions        Session[]
  orgs            OrgMember[]
  organizerYSWSes OrganizerYSWSMembership[]

  createdOrders       PassportOrder[]     @relation("CreatedOrders")
  receivedOrders      PassportOrder[]     @relation("RecipientOrders")
  reviewedSubmissions Submission[]        @relation("ReviewedSubmissions")
  creditTransactions  CreditTransaction[]
  shopOrders          ShopOrder[]

  submissions    Submission[]
  votes          Vote[]
  projects       Project[]
  journalEntries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String @id @default(cuid())
  sessionToken String @unique
  userId       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Org {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  color       String?
  members     OrgMember[]

  ysws            YSWS[]                    @relation("OrgYSWS")
  orders          PassportOrder[]
  organizerYSWSes OrganizerYSWSMembership[]
  submissions     Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizerYSWSMembership {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  yswsId String
  role   OrgRole @default(ORGANIZER)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ysws YSWS @relation(fields: [yswsId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, yswsId])
  @@index([userId])
  @@index([yswsId])
}

model YSWS {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  apiKeyHash      String?   @unique
  apiKeyPrefix    String?   @unique // First 8 chars for fast lookup
  apiKeyDisplay   String? // Last 4 chars for display only
  apiKeyExpiresAt DateTime?
  apiKeyScopes    String[]  @default(["orders:write"])
  apiKeyLastUsed  DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org                  Org                       @relation("OrgYSWS", fields: [orgId], references: [id], onDelete: Cascade)
  orgId                String
  organizerMemberships OrganizerYSWSMembership[]
  orders               PassportOrder[]

  @@index([apiKeyPrefix])
}

enum OrgRole {
  OWNER
  ORGANIZER
}

model OrgMember {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole @default(ORGANIZER)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model PassportOrder {
  id              String          @id @default(cuid())
  orgId           String
  yswsId          String
  totalQuantity   Int
  currentState    OrderTransition @default(AWAITING_RECIPIENT_DETAILS)
  status          OrderStatus     @default(PENDING)
  note            String?
  createdByUserId String?
  recipientUserId String?
  createdFrom     String

  recipientName  String?
  recipientEmail String?
  recipientToken String?   @unique
  archivedAt     DateTime?

  org        Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ysws       YSWS                @relation(fields: [yswsId], references: [id], onDelete: Cascade)
  user       User?               @relation("CreatedOrders", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipient  User?               @relation("RecipientOrders", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipients PassportRecipient[]
  versions   PassportVersion[]
  shipments  Shipment[]
  events     OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([yswsId])
  @@index([createdByUserId])
  @@index([recipientUserId])
  @@index([recipientEmail])
  @@index([recipientToken])
  @@index([archivedAt])
  @@index([orgId, currentState])
  @@index([yswsId, currentState])
  @@index([recipientEmail, archivedAt])
  @@index([createdAt])
}

model PassportRecipient {
  id               String    @id @default(cuid())
  orderId          String
  email            String
  name             String?
  userId           String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  stateProvince    String?
  postalCode       String?
  country          String? // ISO 3166-1 alpha-2
  dateOfBirth      DateTime?
  emergencyContact String?
  photoUrl         String?

  order PassportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, email])
  @@index([orderId])
  @@index([email])
}

model PassportVersion {
  id        String   @id @default(cuid())
  orderId   String
  version   Int
  data      Json?
  createdBy String
  createdAt DateTime @default(now())

  order PassportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, version])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  trackingNumber String?
  carrier        String?
  status         String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  recipientEmail String?
  note           String?

  order PassportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model OrderEvent {
  id            String           @id @default(cuid())
  orderId       String
  eventType     EventType
  status        OrderStatus?
  previousState OrderTransition?
  newState      OrderTransition
  actor         String
  actorType     ActorType
  description   String?
  metadata      Json?
  createdAt     DateTime         @default(now())

  order PassportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@index([eventType, createdAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actor       String
  actorType   ActorType
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  description String?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
}

model EmailDelivery {
  id             String    @id @default(cuid())
  orderId        String?
  recipientEmail String
  eventType      EventType
  status         String // "sent" | "failed" | "retrying" | "pending"
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  @@index([recipientEmail])
  @@index([eventType])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  orgId       String?
  title       String
  description String?
  url         String?
  image       String?
  status      SubmissionStatus @default(SUBMITTED)
  votes       Vote[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedById String?
  reviewedAt   DateTime?

  reviewer           User?               @relation("ReviewedSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)
  creditTransactions CreditTransaction[]

  hackatimeHours Float?
  creditsAwarded Int?

  @@index([userId])
  @@index([orgId])
}

model Vote {
  id           String @id @default(cuid())
  submissionId String
  userId       String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([submissionId, userId])
  @@index([userId])
}

model Project {
  id          String  @id @default(cuid())
  userId      String
  title            String
  description      String?
  githubUrl        String?
  demoUrl          String?
  hackatimeProject String?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  entryDate DateTime
  projectId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

enum CreditTransactionType {
  EARNED
  SPENT
  ADJUSTED
  REFUNDED
}

model CreditTransaction {
  id           String                @id @default(cuid())
  userId       String
  amount       Int // + earn, - spend
  type         CreditTransactionType
  submissionId String?
  shopOrderId  String?
  description  String?
  createdAt    DateTime              @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  shopOrder  ShopOrder?  @relation(fields: [shopOrderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([submissionId])
  @@index([shopOrderId])
}

model ShopItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  price       Int
  category    String?
  stock       Int? // null or -1 = unlimited
  maxPerUser  Int         @default(-1) // -1 = unlimited
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  shopOrders  ShopOrder[]
}

enum ShopOrderStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model ShopOrder {
  id           String          @id @default(cuid())
  userId       String
  itemId       String
  quantity     Int             @default(1)
  creditsSpent Int
  status       ShopOrderStatus @default(PENDING)
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  item               ShopItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([itemId])
}
